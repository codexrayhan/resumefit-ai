# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Data files
# Raw and processed datasets may contain large or sensitive source data.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated model artifacts
models/*
!models/.gitkeep
*.pkl
*.joblib
*.pt
*.pth
*.onnx

# Local machine-learning and NLP caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
huggingface/
nltk_data/

# Environment variables and local secrets
.env
.env.*
!.env.example

# IDE and editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and local reports
*.log
logs/

# Build and packaging output
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/
wheels/

# Test and coverage output
coverage.xml
.coverage
htmlcov/
